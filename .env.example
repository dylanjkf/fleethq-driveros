# Absolute base URL of the API (Railway), e.g. https://api.fleethq.online —
# no trailing slash. Required for any Capacitor (native app store) build —
# there is no same-origin fallback inside a native WebView. See
# src/api/client.ts and capacitor.config.ts.
VITE_API_BASE=""

# Copy to .env.production (gitignored) before a production build if you want
# error tracking active for that build. See ../fleethq/.env.example — same
# reasoning applies here.
VITE_SENTRY_DSN=""
